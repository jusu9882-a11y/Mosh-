@ Device capabilities are queried from the active host adapter.
@ Linux and Android can read battery telemetry through kernel power_supply sysfs.

let camera = device.camera.capabilities()
print(camera["module"])
print(camera["supported"])
print(camera["available"])
print(camera["permission"])

if device.camera.is_supported():
    print(device.camera.permission())
else:
    print(camera["limitations"])

if device.battery.is_supported():
    if device.battery.is_available():
        let battery = device.battery.read()
        print(battery["capacity_percent"])
        print(battery["state"])
    else:
        print(device.battery.capabilities()["limitations"])
else:
    print(device.battery.capabilities()["limitations"])

print(device.wifi_direct.is_supported())
