@ Mosh dictionary example

mut user = {
    "name": "Mosh",
    "language": "Rust",
    "version": 1,
}

print(user["name"])
user["version"] = 2
print(user["version"])
print(has_key(user, "language"))

for key in keys(user):
    print(key, user[key])

let removed = remove(user, "language")
print(removed)
print(len(user))
